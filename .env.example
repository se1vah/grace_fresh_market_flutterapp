# Environment Variables Configuration Example
# You can pass these flags during build or run commands using --dart-define
# Example usage:
# flutter run --dart-define=SERVER_HOST=http://192.168.1.100:3000 --dart-define=ENV=production

SERVER_HOST=http://192.168.1.100:3000
SHOP_API_ENDPOINT=/api/shop
USER_API_ENDPOINT=/api/users
APP_NAME=Grace Fresh Market
API_TIMEOUT=8
SHORT_TIMEOUT=4
ENV=development
AUTH_COOKIE_NAME=user_token
